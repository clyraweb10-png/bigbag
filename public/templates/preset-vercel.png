<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1280 800" width="1280" height="800">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#000000" />
      <stop offset="100%" stop-color="#09090b" />
    </linearGradient>
    <radialGradient id="glow" cx="50%" cy="30%" r="60%">
      <stop offset="0%" stop-color="#ffffff" stop-opacity="0.25" />
      <stop offset="100%" stop-color="#ffffff" stop-opacity="0" />
    </radialGradient>
  </defs>
  
  <rect width="1280" height="800" fill="url(#bg)" />
  <rect width="1280" height="800" fill="url(#glow)" />
  
  <!-- Subtle grid lines -->
  <g opacity="0.08" stroke="#ffffff" stroke-width="1">
    <line x1="0" y1="160" x2="1280" y2="160" />
    <line x1="0" y1="320" x2="1280" y2="320" />
    <line x1="0" y1="480" x2="1280" y2="480" />
    <line x1="0" y1="640" x2="1280" y2="640" />
    <line x1="320" y1="0" x2="320" y2="800" />
    <line x1="640" y1="0" x2="640" y2="800" />
    <line x1="960" y1="0" x2="960" y2="800" />
  </g>
  
  <!-- Top bar / badge -->
  <rect x="520" y="220" width="240" height="40" rx="20" fill="rgba(255,255,255,0.08)" stroke="rgba(255,255,255,0.12)" stroke-width="1" />
  <circle cx="544" cy="240" r="5" fill="#ffffff" />
  <text x="562" y="246" font-family="-apple-system, system-ui, sans-serif" font-size="14" font-weight="600" fill="#ffffff" letter-spacing="1">THEME</text>
  
  <!-- Title -->
  <text x="640" y="360" font-family="-apple-system, system-ui, sans-serif" font-size="56" font-weight="800" fill="#ffffff" text-anchor="middle" letter-spacing="-1.5">Vercel Edge Platform</text>
  
  <!-- Subtitle -->
  <text x="640" y="420" font-family="-apple-system, system-ui, sans-serif" font-size="20" font-weight="400" fill="#94a3b8" text-anchor="middle">Pre-built interactive starter template with live preview</text>
  
  <!-- Mock Button -->
  <rect x="540" y="470" width="200" height="52" rx="26" fill="#ffffff" />
  <text x="640" y="502" font-family="-apple-system, system-ui, sans-serif" font-size="16" font-weight="700" fill="#000000" text-anchor="middle">Explore Template →</text>
</svg>