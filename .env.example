# ---------------------------------------------------------------------------
# BigBag Local Orchestrator (Self-hosted Multi-Model Engine)
# ---------------------------------------------------------------------------
ORCHESTRATOR_MODE=local
SANDBOX_PROVIDER=local
# On a hosted Render service, use E2B so generated previews do not compete with
# the builder process for memory and ports.
# SANDBOX_PROVIDER=e2b

# Set at least one LLM API key:
GLM_API_KEY=
# Use the current coding-focused Flash model. A second account is optional and
# provides independent capacity for automatic failover.
GLM_MODEL=glm-4.7-flash
# GLM_API_KEY_2=
# GLM_MODEL_2=glm-4.7-flash
GLM_MAX_TOKENS=16384
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# E2B_API_KEY=

# Optional reference-site analysis. When a prompt contains a public URL, the
# local orchestrator uses Firecrawl branding/content data to match its design.
# FIRECRAWL_API_KEY=

# Optional cloud backend fallback:
# TOTALUM_VCAAS_API_KEY=local-orchestrator-active

# ---------------------------------------------------------------------------
# Turso Cloud Database (Optional)
# ---------------------------------------------------------------------------
# TURSO_DATABASE_URL=libsql://...
# TURSO_AUTH_TOKEN=
# TURSO_API_TOKEN=
# TURSO_ORG=

# ---------------------------------------------------------------------------
# Firebase Google sign-in
# ---------------------------------------------------------------------------
# The checked-in Firebase web configuration is public client metadata. Override
# it when deploying your own Firebase project, then enable the Google provider
# and add your deployment hostname under Firebase Authentication domains.
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=
# NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
# Optional comma-separated account allowlist (empty means any Google account):
# FIREBASE_ALLOWED_EMAILS=owner@example.com
# One-time migration for projects created before authentication. Enable only
# together with a strict FIREBASE_ALLOWED_EMAILS value, then disable after claim.
# FIREBASE_CLAIM_LEGACY_PROJECTS=false

# Render persistent disk example (mount one disk at /var/data). Without a disk,
# Render's ephemeral filesystem loses local project metadata after redeploys.
# BIGBAG_DATA_DIR=/var/data/bigbag-data
# BIGBAG_WORKSPACES_DIR=/var/data/bigbag-workspaces

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# Public base URL of this app. Used by src/proxy.ts to allow-list the origin
# for CSP/CORS in production. Defaults to same-host if unset, so you usually
# only need this for a custom production domain.
# NEXT_PUBLIC_APP_URL=https://your-domain.com
