# ---------------------------------------------------------------------------
# BigBag Local Orchestrator (Self-hosted Multi-Model Engine)
# ---------------------------------------------------------------------------
ORCHESTRATOR_MODE=local
SANDBOX_PROVIDER=e2b

# 1. Google Gemini (Primary Model)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# GEMINI_MAX_TOKENS=16384

# 2. Telnyx AI / Custom OpenAI (Fallback Model)
TELNYX_API_KEY=
# TELNYX_MODEL=zai-org/GLM-5.3-Flash
# TELNYX_BASE_URL=https://api.telnyx.com/v2/ai/openai
# TELNYX_MAX_TOKENS=16384

# Sandbox Execution:
E2B_API_KEY=

# Website-reference design analysis (runs before generation when a prompt has a URL):
FIRECRAWL_API_KEY=

# Optional cloud backend fallback:
# TOTALUM_VCAAS_API_KEY=local-orchestrator-active

# ---------------------------------------------------------------------------
# Durable project/source/deployment storage (required in local-orchestrator mode)
# ---------------------------------------------------------------------------
# TURSO_DATABASE_URL=libsql://...
# TURSO_AUTH_TOKEN=
# TURSO_API_TOKEN=
# TURSO_ORG=

# Dedicated random secret that signs anonymous tenant-isolation cookies.
# Required whenever NODE_ENV=production; do not reuse a provider credential.
# TENANT_COOKIE_SECRET=
# Existing unowned filesystem projects are never claimed by a new browser.
FIREBASE_CLAIM_LEGACY_PROJECTS=false

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# Public base URL of this app. Used by src/proxy.ts to allow-list the origin
# for CSP/CORS in production. Defaults to same-host if unset, so you usually
# only need this for a custom production domain.
# NEXT_PUBLIC_APP_URL=https://your-domain.com
