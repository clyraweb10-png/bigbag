# ---------------------------------------------------------------------------
# BigBag Local Orchestrator (GLM 5.3 Flash)
# ---------------------------------------------------------------------------
ORCHESTRATOR_MODE=local
SANDBOX_PROVIDER=e2b

# Server-only inference for generation, chat, planning, and reference analysis.
# BigBag uses only above.dev's GLM 5.3 Flash modal route. Do not prefix ABOVE_API_KEY with NEXT_PUBLIC_.
ABOVE_API_KEY=
# ABOVE_BASE_URL=https://api.above.dev/v1

# Sandbox Execution:
E2B_API_KEY=
E2B_BUILD_TEMPLATE=

# Website-reference design analysis (runs before generation when a prompt has a URL):
FIRECRAWL_API_KEY=
# Maximum validated representative images sent to reference analysis (1-12).
# REFERENCE_ANALYSIS_MAX_IMAGES=6
# Per-image and total vision budgets, in bytes. Oversized assets remain available
# to implementation but are not sent to the analysis model.
# REFERENCE_ANALYSIS_MAX_IMAGE_BYTES=5242880
# REFERENCE_ANALYSIS_MAX_TOTAL_IMAGE_BYTES=14680064
# Maximum deduplicated asset URLs retained in the compact reference package.
# REFERENCE_ANALYSIS_MAX_ASSETS=60
# Firecrawl full-page screenshot quality (50-90) and bounded analysis output.
# REFERENCE_ANALYSIS_SCREENSHOT_QUALITY=72
# REFERENCE_ANALYSIS_MAX_TOKENS=1800

# Optional licensed photography sourcing for image-forward generation prompts.
# When absent or when no suitable result exists, generation uses a designed
# CSS/SVG fallback rather than an empty or broken image placeholder.
PEXELS_API_KEY=

# Optional cloud backend fallback:
# TOTALUM_VCAAS_API_KEY=local-orchestrator-active
# Cloud mode is single-operator and fails closed. Comma-separate the Supabase
# user IDs that may use the shared operator credential.
# VCAAS_OPERATOR_UIDS=

# ---------------------------------------------------------------------------
# Durable project/source/deployment storage (Supabase PostgreSQL)
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
# SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
# SUPABASE_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Dedicated random secret that signs anonymous tenant-isolation cookies.
# Required whenever NODE_ENV=production; do not reuse a provider credential.
# TENANT_COOKIE_SECRET=

# Supabase Auth (Google Sign-in). Enable the Google provider in your Supabase
# Dashboard under Authentication -> Providers -> Google, with your Google Cloud
# OAuth Client ID and Client Secret. Ensure your Google OAuth Authorized Redirect URI
# includes: https://<project-ref>.supabase.co/auth/v1/callback

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# Public base URL of this app. Used by src/proxy.ts to allow-list the origin
# for CSP/CORS in production. Defaults to same-host if unset, so you usually
# only need this for a custom production domain.
# NEXT_PUBLIC_APP_URL=https://your-domain.com
